<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fab_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_fab_tile"
    android:contentDescription="@string/widget_quick_add_fab_label"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_fab_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:contentDescription="@string/cd_add_task"
        android:src="@drawable/ic_widget_add_lg" />
</FrameLayout>
