<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_next_priority_bar"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_widget_priority_high" />

    <ImageButton
        android:id="@+id/widget_next_checkbox"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_toggle_task"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_checkbox_unchecked" />

    <LinearLayout
        android:id="@+id/widget_next_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_next_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_next_up_eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent_blue"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_task_1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_meta_1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_next_add"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_widget_add_button"
        android:contentDescription="@string/cd_add_task"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_add" />
</LinearLayout>
